{
  "name": "Skill Ledger",
  "short_name": "Skill Ledger",
  "description": "Impara, prendi appunti e ripassa con flashcard e quiz.",
  "lang": "it",
  "start_url": "./#/",
  "scope": "./",
  "display": "standalone",
  "background_color": "#F4F6F9",
  "theme_color": "#3552C9",
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ],
  "shortcuts": [
    {
      "name": "Ripassa flashcard",
      "url": "./#/study/cards?scope=all"
    },
    {
      "name": "Registro",
      "url": "./#/log"
    }
  ],
  "share_target": {
    "action": "./",
    "method": "GET",
    "params": {
      "title": "share_title",
      "text": "share_text",
      "url": "share_url"
    }
  }
}
